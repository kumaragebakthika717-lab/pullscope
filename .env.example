# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Not read by the app at runtime today; keep it for admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for share links and OAuth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed for `npm run db:migrate` (Project Settings → Database → Connection string, session pooler)
DATABASE_URL=
